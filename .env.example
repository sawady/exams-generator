# Transport: "stdio" (local client such as Claude Code) or "http" (remote).
EXAMS_TRANSPORT=http

# HTTP mode only.
EXAMS_HTTP_HOST=0.0.0.0
EXAMS_HTTP_PORT=8765
# Required in HTTP mode. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
EXAMS_BEARER_TOKEN=change-me
# Public host names clients use (enables Host/Origin checks), comma separated.
# Required when EXAMS_HTTP_HOST=127.0.0.1 behind a reverse proxy.
# EXAMS_ALLOWED_HOSTS=exams.example.org

# Where exams are stored. Ideally a clone of a separate private git repository.
EXAMS_DIR=/exams
# Overrides for course.md, style guides, templates and the pandoc header.
EXAMS_DATA_DIR=/data
# Commit every change in EXAMS_DIR; optionally push it to the upstream branch.
EXAMS_GIT_BACKUP=true
EXAMS_GIT_PUSH=false

# Default language of the exams: en or es.
EXAMS_LOCALE=en

# Docker compose only: host paths mounted at /exams and /data.
# EXAMS_HOST_DIR=../my-private-exams
# EXAMS_HOST_DATA_DIR=./data

# Optional: the run_demos tool EXECUTES solutions. It does not exist unless this is true.
# See "Running demos" in the README before enabling it.
# EXAMS_RUN_DEMOS=true
# Local mode (Linux, needs bubblewrap):
# EXAMS_RUN_TIMEOUT=30
# EXAMS_RUN_MEMORY_MB=4096
# EXAMS_RUN_RO_BINDS=/home/you/.ghcup
# Separate runner instead: compose.yaml sets this for you; start it with --profile demos.
# EXAMS_RUN_RUNNER_URL=http://runner:8766
# EXAMS_RUN_RUNNER_TIMEOUT=300
